{
  "appId": "br.com.meudinheiro.app",
  "appName": "Meu Dinheiro",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0f766e"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0f766e",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f766e"
    }
  }
}
